{
  // --- interpreter (runtime) -------------------------------------------------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  // --- suggestions: nothing pops up on its own --------------------------------
  // Completions still exist; you ask for them with Ctrl+Space.
  "editor.quickSuggestions": { "other": "off", "comments": "off", "strings": "off" },
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.parameterHints.enabled": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.suggest.preview": false,
  "editor.suggest.showWords": false,
  "editor.tabCompletion": "off",
  "editor.snippetSuggestions": "none",

  // Hover and snippets
  "editor.hover.enabled": "off",
  "editor.suggest.snippetsPreventQuickSuggestions": false,

  // --- font & typography ------------------------------------------------------
  "editor.fontFamily": "monofur, 'Fira Code', 'JetBrains Mono', 'Fira Code', 'Go Mono', 'Ubuntu Sans Mono', 'DejaVu Sans Mono', monospace",
  "editor.fontSize" : 18,
  "editor.fontLigatures": true,
  "antigravity.tabToJump": false,
  "antigravity.autocomplete": false
}
